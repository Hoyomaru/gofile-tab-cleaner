{
  "manifest_version": 3,
  "name": "Gofile Tab Cleaner",
  "version": "0.5.0",
  "description": "Gofile の /d/<contentId> タブについて、不存在が確定したタブを閉じ、同一コンテンツの重複タブを整理します。Too many requests のタブは時間をおいて再読み込みします。",
  "permissions": ["tabs", "storage", "scripting", "alarms"],
  "host_permissions": ["https://gofile.io/*", "https://www.gofile.io/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://gofile.io/d/*", "https://www.gofile.io/d/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gofile Tab Cleaner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
