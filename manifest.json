{
  "manifest_version": 3,
  "name": "Gofile Tab Cleaner",
  "version": "0.7.0",
  "minimum_chrome_version": "102",
  "description": "Gofile の /d/<contentId> タブについて、不存在・重複・ダウンロード済み（gofile-jd2 で送ったもの）のタブを閉じます。Too many requests のタブは時間をおいて再読み込みし、URL の一覧は少しずつまとめて開きます。",
  "permissions": ["storage", "scripting", "alarms", "contextMenus", "activeTab"],
  "host_permissions": ["https://gofile.io/*", "https://www.gofile.io/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://gofile.io/*", "https://www.gofile.io/*"],
      "js": ["common.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gofile Tab Cleaner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
